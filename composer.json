{
	"name" : "tagadvance/elephant",
	"description" : "A strongly-typed wrapper around PHP's OpenSSL extension for RSA keys, certificates, and encryption.",
	"type" : "library",
	"keywords": ["openssl", "cryptography", "encryption", "rsa", "x509", "certificate"],
	"license" : "MIT",
	"authors" : [{
			"name" : "Tag",
			"email" : "tagadvance+elephant@gmail.com"
		}
	],
	"require" : {
		"php" : "^8.4",
		"ext-openssl": "*"
	},
	"require-dev" : {
		"friendsofphp/php-cs-fixer" : "^3.95",
		"phpstan/phpstan" : "^2.2",
		"phpunit/phpunit" : "^13.3"
	},
	"autoload" : {
		"psr-4" : {
			"" : "src/"
		}
	}
}
